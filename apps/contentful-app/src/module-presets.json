                  }
                ]
              }
            },
            {
              "type": "Flex",
              "props": {
                "id": "c1b",
                "direction": "column",
                "align": "start",
                "gap": "xs",
                "padding": "md",
                "children": [
                  {
                    "type": "Typography",
                    "props": {
                      "id": "c1t",
                      "variant": "title",
                      "size": "md",
                      "text": {
                        "en": "Travel connected from the moment you arrive",
                        "zh": "落地即联网"
                      }
                    }
                  },
                  {
                    "type": "Typography",
                    "props": {
                      "id": "c1d",
                      "variant": "body",
                      "text": {
                        "en": "Skip roaming fees and enjoy reliable data throughout your trip",
                        "zh": "免漫游费，全程畅享稳定网络"
                      }
                    }
                  },
                  {
                    "type": "Typography",
                    "props": {
                      "id": "c1l",
                      "variant": "body",
                      "weight": "medium",
                      "color": "linkColor",
                      "text": {
                        "en": "Get an eSIM",
                        "zh": "获取 eSIM"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
